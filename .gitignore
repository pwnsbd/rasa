# Node
node_modules/
ui/dist/
dist/
dist-electron/
build/
*.log
npm-debug.log*
*.tsbuildinfo

# Python
sidecar/venv/
sidecar/__pycache__/
sidecar/**/__pycache__/
*.pyc
sidecar/tmp-devdata/

# App data / Essences / models / generated media (never commit large binaries)
# appdata/ is Electron's whole relocated userData root (see electron/main.js) —
# app-data folders, model cache, and Electron's own internal caches all land here.
appdata/
models/
sidecar/models/
**/*.sqlite
**/*.sqlite3
**/essences/*
**/media/*

# Editor / OS
.vscode/
.DS_Store
Thumbs.db

# QA screenshots from scripts/verify-launch.mjs / verify-flow.mjs
.tmp-shots/

# Packaging output
*.exe
*.dmg
*.AppImage
*.msi
release/

# Fetched at build-prep time by scripts/fetch-embed-python.js (npm run
# dist:prep) — a real binary Python distribution, not source, reproducible
# from that script, never committed.
resources/

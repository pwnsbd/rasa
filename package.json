{
  "name": "rasa",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, GPU-aware desktop app for extracting the visual style of a reference image (an Essence) and reapplying it to other photos.",
  "main": "electron/main.js",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "dev:ui": "npm run dev --workspace ui",
    "dev": "concurrently -k -n UI,ELECTRON -c cyan,magenta \"npm:dev:ui\" \"electron .\"",
    "build:ui": "npm run build --workspace ui",
    "start": "electron .",
    "sidecar:setup": "node scripts/setup-sidecar.js",
    "dist:prep": "node scripts/fetch-embed-python.js",
    "dist": "npm run build:ui && npm run dist:prep && electron-builder --win"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.rasa.desktop",
    "productName": "Rasa",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "ui/dist/**/*",
      "package.json",
      "!**/node_modules/**/{CHANGELOG.md,README.md,readme.md,.eslintrc,.travis.yml}"
    ],
    "extraResources": [
      { "from": "sidecar", "to": "sidecar", "filter": ["**/*", "!venv", "!tests", "!__pycache__", "!**/__pycache__/**"] },
      { "from": "LICENSE", "to": "LICENSE" },
      { "from": "THIRD_PARTY_LICENSES.md", "to": "THIRD_PARTY_LICENSES.md" },
      { "from": "resources/python-embed", "to": "python-embed" }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
